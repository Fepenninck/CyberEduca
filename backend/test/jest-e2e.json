{
  "preset": "ts-jest/presets/default-esm",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "setupFiles": [
    "<rootDir>/setup-test-env.ts"
  ],
  "maxWorkers": 1,
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}