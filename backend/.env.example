# PostgreSQL local: crie antes um banco chamado cybereduca.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/cybereduca?schema=public"
# Opcional: conex?o direta para migra??es. Se vazia, o CLI deriva o endere?o direto do Neon.
DIRECT_URL=""
JWT_SECRET="gere-uma-chave-longa-e-aleatoria"
FRONTEND_URL="http://localhost:3001"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
VIRUSTOTAL_API_KEY=""
# Envio de e-mails. Em produção (Render gratuito) use BREVO_API_KEY, porque as portas SMTP são bloqueadas.
# Localmente, sem BREVO_API_KEY, o envio usa SMTP (Gmail com senha de app).
BREVO_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="seu-email@exemplo.com"
SMTP_PASS="SUA_SENHA_DE_APP"
MAIL_FROM="CyberEduca+ <seu-email@exemplo.com>"
