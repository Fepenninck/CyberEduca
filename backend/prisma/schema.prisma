generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String          @id @default(uuid())
  nome       String
  email      String          @unique
  senhaHash  String
  papel      String          @default("USUARIO")
  criadoEm   DateTime        @default(now())
  progressos ProgressoAula[]
}

model Trilha {
  id        String @id @default(uuid())
  titulo    String
  descricao String
  ordem     Int
  aulas     Aula[]
}

model Aula {
  id         String          @id @default(uuid())
  titulo     String
  conteudo   String
  ordem      Int
  trilhaId   String
  trilha     Trilha          @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  progressos ProgressoAula[]

  @@unique([trilhaId, ordem])
}

model ProgressoAula {
  id            String   @id @default(uuid())
  usuarioId     String
  aulaId        String
  concluida     Boolean  @default(true)
  dataConclusao DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aula          Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, aulaId])
}
