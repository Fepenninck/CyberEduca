generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                       String              @id @default(uuid())
  nome                     String
  email                    String              @unique
  senhaHash                String?
  googleId                 String?             @unique
  foto                     String?
  avatar                   String?
  papel                    String              @default("USUARIO")
  criadoEm                 DateTime            @default(now())
  atualizadoEm             DateTime            @default(now()) @updatedAt
  tokenRecuperacaoHash     String?             @unique
  tokenRecuperacaoExpiraEm DateTime?
  progressos               ProgressoAula[]
  auditorias               LogAuditoria[]
  tentativasQuiz           TentativaQuiz[]
  tentativasPhishing       TentativaPhishing[]
  consultasSeguranca       ConsultaSeguranca[]
  resultadosSimulacoes ResultadoSimulacao[]
  resultadosProvas ResultadoProva[]
  tentativasProva TentativaProva[]
}

model Trilha {
  id        String      @id @default(uuid())
  titulo    String
  descricao String
  nivel     NivelTrilha @default(BASICO)
  bloqueada Boolean     @default(false)
  ordem     Int
  aulas     Aula[]
  provas    Prova[]
}

enum NivelTrilha {
  BASICO
  INTERMEDIARIO
  AVANCADO
}

model Aula {
  id               String            @id @default(uuid())
  titulo           String
  conteudo         String            @default("")
  ordem            Int
  trilhaId         String
  trilha           Trilha            @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  progressos       ProgressoAula[]
  quizzes          Quiz[]
  cenariosPhishing CenarioPhishing[]

  @@unique([trilhaId, ordem])
}

enum StatusProva {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

model Prova {
  id           String           @id @default(uuid())
  titulo       String
  descricao    String @default("")
  trilhaId     String
  status       StatusProva      @default(RASCUNHO)
  criadoEm     DateTime         @default(now())
  atualizadoEm DateTime         @default(now()) @updatedAt
  trilha       Trilha           @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  questoes     QuestaoProva[]
  resultados   ResultadoProva[]
  tentativas TentativaProva[]

  @@index([trilhaId])
  @@index([status])
}

model QuestaoProva {
  id           String             @id @default(uuid())
  enunciado    String
  explicacao   String             @default("")
  ordem        Int                @default(0)
  tipo         TipoQuestao        @default(MULTIPLA_ESCOLHA)
  provaId      String
  prova        Prova              @relation(fields: [provaId], references: [id], onDelete: Cascade)
  alternativas AlternativaProva[]
  respostas RespostaProva[]

  @@unique([provaId, ordem])
}

enum TipoQuestao {
  MULTIPLA_ESCOLHA
  DISSERTATIVA
}

model AlternativaProva {
  id        String       @id @default(uuid())
  texto     String
  isCorreta Boolean      @default(false) @map("correta")
  ordem     Int          @default(0)
  questaoId String
  questao   QuestaoProva @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  respostas RespostaProva[]

  @@unique([questaoId, ordem])
}

model Simulacao {
  id          String               @id @default(uuid())
  titulo      String
  descricao   String
  nivel       NivelTrilha          @default(BASICO)
  duracaoMinutos Int               @default(5)
  criadoEm    DateTime             @default(now())
  categoriaId String
  categoria   CategoriaSimulacao   @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  questoes    QuestaoSimulacao[]
  resultados  ResultadoSimulacao[]
}

model CategoriaSimulacao {
  id         String      @id @default(uuid())
  nome       String      @unique
  descricao  String
  criadoEm   DateTime    @default(now())
  simulacoes Simulacao[]
}

model ResultadoSimulacao {
  id            String    @id @default(uuid())
  usuarioId     String
  simulacaoId   String
  acertos       Int
  totalQuestoes Int
  respostas     Json?
  criadoEm      DateTime  @default(now())
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  simulacao     Simulacao @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)

  @@index([usuarioId, simulacaoId, criadoEm])
}

model ResultadoProva {
  id            String   @id @default(uuid())
  usuarioId     String
  provaId       String
  acertos       Int
  totalQuestoes Int
  criadoEm      DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  prova         Prova    @relation(fields: [provaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, provaId])
}

model QuestaoSimulacao {
  id           String                 @id @default(uuid())
  enunciado    String
  contexto     String                 @default("")
  explicacao   String                 @default("")
  ordem        Int                    @default(0)
  simulacaoId  String
  simulacao    Simulacao              @relation(fields: [simulacaoId], references: [id], onDelete: Cascade)
  alternativas AlternativaSimulacao[]
}

model AlternativaSimulacao {
  id        String           @id @default(uuid())
  texto     String
  ordem     Int              @default(0)
  isCorreta Boolean          @default(false)
  questaoId String
  questao   QuestaoSimulacao @relation(fields: [questaoId], references: [id], onDelete: Cascade)
}

model ProgressoAula {
  id            String   @id @default(uuid())
  usuarioId     String
  aulaId        String
  concluida     Boolean  @default(true)
  dataConclusao DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aula          Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, aulaId])
}

enum AcaoAuditoria {
  CADASTRO
  LOGIN
  LOGIN_FALHOU
  ATUALIZAR
  CRIAR
  EXCLUIR
  CONCLUIR_AULA
  LOGOUT
}

model LogAuditoria {
  id         String        @id @default(uuid())
  acao       AcaoAuditoria
  entidade   String
  entidadeId String?
  atorId     String?
  ator       Usuario?      @relation(fields: [atorId], references: [id], onDelete: SetNull)

  dadosAnteriores Json?
  dadosNovos      Json?
  detalhes        Json?

  ip        String?
  userAgent String?
  sucesso   Boolean  @default(true)
  erro      String?
  criadoEm  DateTime @default(now())

  @@index([atorId])
  @@index([entidade, entidadeId])
  @@index([acao])
  @@index([criadoEm])
}

enum StatusAtividade {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum TipoCenarioPhishing {
  EMAIL
  SMS
  SITE
  REDE_SOCIAL
}

enum ResultadoConsultaSeguranca {
  SEM_DETECCOES
  SUSPEITO
  MALICIOSO
  SEM_DADOS
}

model Quiz {
  id           String          @id @default(uuid())
  titulo       String
  descricao    String
  aulaId       String
  status       StatusAtividade @default(RASCUNHO)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  aula       Aula            @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  questoes   QuestaoQuiz[]
  tentativas TentativaQuiz[]

  @@index([aulaId, status])
  @@index([status])
}

model QuestaoQuiz {
  id         String @id @default(uuid())
  quizId     String
  enunciado  String
  explicacao String
  ordem      Int

  quiz         Quiz              @relation(fields: [quizId], references: [id], onDelete: Restrict)
  alternativas AlternativaQuiz[]
  respostas    RespostaQuiz[]

  @@unique([quizId, ordem])
}

model AlternativaQuiz {
  id        String  @id @default(uuid())
  questaoId String
  texto     String
  correta   Boolean @default(false)
  ordem     Int

  questao   QuestaoQuiz    @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  respostas RespostaQuiz[]

  @@unique([questaoId, ordem])
}

model TentativaQuiz {
  id            String   @id @default(uuid())
  usuarioId     String
  quizId        String
  totalQuestoes Int
  totalAcertos  Int
  concluidoEm   DateTime @default(now())

  usuario   Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Restrict)
  respostas RespostaQuiz[]

  @@index([usuarioId, concluidoEm])
  @@index([quizId])
}

model RespostaQuiz {
  id            String  @id @default(uuid())
  tentativaId   String
  questaoId     String
  alternativaId String
  acertou       Boolean

  tentativa   TentativaQuiz   @relation(fields: [tentativaId], references: [id], onDelete: Cascade)
  questao     QuestaoQuiz     @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  alternativa AlternativaQuiz @relation(fields: [alternativaId], references: [id], onDelete: Restrict)

  @@unique([tentativaId, questaoId])
  @@index([questaoId])
  @@index([alternativaId])
}

model CenarioPhishing {
  id               String              @id @default(uuid())
  titulo           String
  descricao        String
  conteudoMensagem String
  tipo             TipoCenarioPhishing
  ehPhishing       Boolean
  explicacao       String
  aulaId           String
  status           StatusAtividade     @default(RASCUNHO)
  criadoEm         DateTime            @default(now())
  atualizadoEm     DateTime            @updatedAt

  aula       Aula                @relation(fields: [aulaId], references: [id], onDelete: Restrict)
  tentativas TentativaPhishing[]

  @@index([aulaId, status])
  @@index([status])
}

model TentativaPhishing {
  id                 String   @id @default(uuid())
  usuarioId          String
  cenarioId          String
  respostaEhPhishing Boolean
  acertou            Boolean
  concluidoEm        DateTime @default(now())

  usuario Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cenario CenarioPhishing @relation(fields: [cenarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId, concluidoEm])
  @@index([cenarioId])
}

model ConsultaSeguranca {
  id           String                     @id @default(uuid())
  usuarioId    String
  dominio      String
  provedor     String                     @default("VIRUSTOTAL")
  resultado    ResultadoConsultaSeguranca
  consultadoEm DateTime                   @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, consultadoEm])
  @@index([dominio])
}

model TentativaProva {
  id            String          @id @default(uuid())
  usuarioId     String
  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  provaId       String
  prova         Prova           @relation(fields: [provaId], references: [id], onDelete: Cascade)
  nota          Float           @default(0)
  totalQuestoes Int             @default(0)
  totalAcertos  Int             @default(0)
  iniciadoEm    DateTime        @default(now())
  concluidoEm   DateTime?
  respostas     RespostaProva[]

  @@index([usuarioId])
  @@index([provaId])
}

model RespostaProva {
  id            String           @id @default(uuid())
  tentativaId   String
  tentativa     TentativaProva   @relation(fields: [tentativaId], references: [id], onDelete: Cascade)
  questaoId     String
  questao       QuestaoProva     @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  alternativaId String
  alternativa   AlternativaProva @relation(fields: [alternativaId], references: [id], onDelete: Cascade)
  acertou       Boolean          @default(false)

  @@unique([tentativaId, questaoId])
}
