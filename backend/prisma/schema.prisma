generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                       String          @id @default(uuid())
  nome                     String
  email                    String          @unique
  senhaHash                String?
  googleId                 String?         @unique
  foto                     String?
  papel                    String          @default("USUARIO")
  criadoEm                 DateTime        @default(now())
  atualizadoEm             DateTime        @default(now()) @updatedAt
  tokenRecuperacaoHash     String?         @unique
  tokenRecuperacaoExpiraEm DateTime?
  progressos               ProgressoAula[]
  auditorias               LogAuditoria[]
  tentativasProva          TentativaProva[]
}

model Trilha {
  id        String      @id @default(uuid())
  titulo    String
  descricao String
  nivel     NivelTrilha @default(BASICO)
  bloqueada Boolean     @default(false)
  ordem     Int
  aulas     Aula[]
  provas    Prova[]
}

enum NivelTrilha {
  BASICO
  INTERMEDIARIO
  AVANCADO
}

model Aula {
  id         String          @id @default(uuid())
  titulo     String
  conteudo   String          @default("")
  ordem      Int
  trilhaId   String
  trilha     Trilha          @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  progressos ProgressoAula[]

  @@unique([trilhaId, ordem])
}

model ProgressoAula {
  id            String   @id @default(uuid())
  usuarioId     String
  aulaId        String
  concluida     Boolean  @default(true)
  dataConclusao DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aula          Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, aulaId])
}

enum AcaoAuditoria {
  CADASTRO
  LOGIN
  LOGIN_FALHOU
  ATUALIZAR
  CRIAR
  EXCLUIR
  CONCLUIR_AULA
  LOGOUT
}

model LogAuditoria {
  id         String        @id @default(uuid())
  acao       AcaoAuditoria
  entidade   String
  entidadeId String?
  atorId     String?
  ator       Usuario?      @relation(fields: [atorId], references: [id], onDelete: SetNull)

  dadosAnteriores Json?
  dadosNovos      Json?
  detalhes        Json?

  ip        String?
  userAgent String?
  sucesso   Boolean  @default(true)
  erro      String?
  criadoEm  DateTime @default(now())

  @@index([atorId])
  @@index([entidade, entidadeId])
  @@index([acao])
  @@index([criadoEm])
}

enum StatusProva {
  RASCUNHO
  PUBLICADA
  ARQUIVADA
}

model Prova {
  id           String          @id @default(uuid())
  titulo       String
  descricao    String          @default("")
  trilhaId     String
  trilha       Trilha          @relation(fields: [trilhaId], references: [id], onDelete: Cascade)
  status       StatusProva     @default(RASCUNHO)
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @default(now()) @updatedAt
  questoes     QuestaoProva[]
  tentativas   TentativaProva[]

  @@index([trilhaId])
  @@index([status])
}

model QuestaoProva {
  id           String             @id @default(uuid())
  provaId      String
  prova        Prova              @relation(fields: [provaId], references: [id], onDelete: Cascade)
  enunciado    String
  ordem        Int
  alternativas AlternativaProva[]
  respostas    RespostaProva[]

  @@unique([provaId, ordem])
}

model AlternativaProva {
  id        String          @id @default(uuid())
  questaoId String
  questao   QuestaoProva    @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  texto     String
  correta   Boolean         @default(false)
  ordem     Int
  respostas RespostaProva[]

  @@unique([questaoId, ordem])
}

model TentativaProva {
  id            String          @id @default(uuid())
  usuarioId     String
  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  provaId       String
  prova         Prova           @relation(fields: [provaId], references: [id], onDelete: Cascade)
  nota          Float           @default(0)
  totalQuestoes Int             @default(0)
  totalAcertos  Int             @default(0)
  iniciadoEm    DateTime        @default(now())
  concluidoEm   DateTime?
  respostas     RespostaProva[]

  @@index([usuarioId])
  @@index([provaId])
}

model RespostaProva {
  id            String           @id @default(uuid())
  tentativaId   String
  tentativa     TentativaProva   @relation(fields: [tentativaId], references: [id], onDelete: Cascade)
  questaoId     String
  questao       QuestaoProva     @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  alternativaId String
  alternativa   AlternativaProva @relation(fields: [alternativaId], references: [id], onDelete: Cascade)
  acertou       Boolean          @default(false)

  @@unique([tentativaId, questaoId])
}
